@using System.Text
@using ws_server_web.Components.Pages
@using ws_server_web.Datashare
@using ws_server_web.Models
@inject NavigationManager NavManager;
@inject IJSRuntime JS;

<p>Connection flow. Player choose some data or what-have-you.</p>
<br />
<InputText @bind-Value="chosenName"></InputText>
<InputSelect TValue="string" @bind-Value="@endpoint" >
    <option selected="true">test</option>
    <option>ws</option>
    <option>a</option>
    <option>b</option>
    <option>c</option>
</InputSelect>
<br />
<button onclick="@DoConnection">Connect to '@endpoint'</button>

@code {
    private string chosenName = "";
    private string endpoint = "test";
    //parent
    [Parameter] public Client Context { get; set; }

    [Parameter] public string ConnectionURL { get; set; } = "";
    public void DoConnection()
    {
        if (chosenName == "")
        {
            //error!
            return;
        }
        Console.Write($"Do Connection to endpoint {endpoint}");
        Context.ConnectAsNew(endpoint, chosenName);
    }
}
