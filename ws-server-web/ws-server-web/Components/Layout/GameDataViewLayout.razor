@using System.Text
@using ws_server_web.Datashare
@using ws_server_web.Models
@inject NavigationManager NavManager;
@inject IJSRuntime JS;

<h1>Server</h1>

<p>Connnection URL: <em id="connection">@ConnectionURL</em></p>
<p>Active Connected Clients: @_activeConnections</p>
<p>This is the current data held on the server at the "test" endpoint. It does not refresh automatically. All data is lost when the server crashes or restarts.</p>

<hr />

@if (_gameData == null)
{
<p>
    <em>Loading...</em>
</p>
}
else
{
    <h2>Server</h2>
    if (_gameData.serverData != null)
    {
        <ul>
            <li>Round: @_gameData.serverData.Round</li>
            <li>RoundState: @_gameData.serverData.roundState.ToString()</li>
        </ul>
        <p>Scores</p>
        <ul>
            @foreach (var score in _gameData.serverData.Scores)
        {
                <li>@score.id: @score.data</li>
            }
        </ul>
    }
    else
    {
        <p>No server data</p>
    }

    <h2>Clients</h2>
<table class="table">
    <thead>
    <tr>
        <th>Client ID</th>
        <th>Favorite Number</th>
        <th>Message (utf8)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var cd in _gameData.clientData.Values)
    {
    <tr>
        <td>@cd.clientID</td>
        <td>@cd.favoriteNumber</td>
        <td>@cd.message</td>
    </tr>
    }
    </tbody>
</table>
}
<script>
    //todo: this doesn't work yet.
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
      const arrayBuffer = await contentStreamReference.arrayBuffer();
      const blob = new Blob([arrayBuffer]);
      const url = URL.createObjectURL(blob);
      const anchorElement = document.createElement('a');
      anchorElement.href = url;
      anchorElement.download = fileName ?? '';
      anchorElement.click();
      anchorElement.remove();
      URL.revokeObjectURL(url);
    }
</script>

@code {
    [Parameter]
    public string StoreID { get; set; }
    private string ConnectionURL;
    private GameData? _gameData;
    private int _activeConnections;

    protected override async Task OnInitializedAsync()
    {
        DataStoreHub.TryGetDataStore(StoreID, out _gameData);
        if (_gameData == null)
        {
            //uh oh! uh, we can update the page to say 'error' or something i guess.
            return;
        }

        _gameData.OnClientChanged += OnClientChanged;
        _gameData.OnServerChanged += OnServerChanged;
        if (DataStoreHub.Connections.TryGetValue(StoreID, out int v))
        {
            _activeConnections = v;
        }
        else
        {
            _activeConnections = 0;
        }
        DataStoreHub.OnConnectionChanged += OnConnectionChanged;
        //set connection url
        ConnectionURL = NavManager.BaseUri;
        ConnectionURL = ConnectionURL.Replace("https", "wss");
        ConnectionURL = ConnectionURL.Replace("http", "ws");
        ConnectionURL += StoreID;
        
    }

    private void OnServerChanged()
    {
        //just brute refresh the whole content
        InvokeAsync(StateHasChanged);
    }

    private void OnClientChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnConnectionChanged(string id, int newDelta)
    {
        if (StoreID == id)
        {
            _activeConnections = newDelta;
        }

        InvokeAsync(StateHasChanged);
    }
}
