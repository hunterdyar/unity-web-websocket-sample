@page "/"
@using System.Diagnostics
@using ws_server_web.Datashare
@using ws_server_web.Models
@using ws_server_web.Components.Layout
@attribute [StreamRendering]

<PageTitle>Web Client</PageTitle>
<h1>WS Client</h1>


@if (!Connected)
{
    <ClientConnect Context="@this"></ClientConnect>
}
else
{
    
}
@code
{
    string serverurl;
    string clientID = "";
    bool Connected = false;
    GameData? _gameData; 
    protected override void OnInitialized()
    {
        DataStoreHub.OnConnectionChanged += OnConnectionChanged;
        
    }

    private void OnConnectionChanged(string arg1, int arg2)
    {
        InvokeAsync(StateHasChanged);
    }

    public void ConnectAsNew(string endpoint, string chosenName)
    {
        if(DataStoreHub.TryGetDataStore(endpoint, out GameData gd))
        {
            SubscribeToEvents(gd);
            clientID = chosenName;
            //send event to server.
            gd.SetClientData(chosenName, new ClientData());
            Console.WriteLine($"connected to {endpoint}");
            Connected = true;
        }else
        {
            Console.WriteLine($"connection to {endpoint} failed");
            Connected = false;
        }
        
        InvokeAsync(StateHasChanged);
    }

    private void SubscribeToEvents(GameData gd)
    {
        if (_gameData != null)
        {
            //unsubscribe from old events...
        }

        _gameData = gd;
        _gameData.OnClientChanged += OnClientChanged;
        _gameData.OnServerChanged += OnServerChanged;
    }

    private void OnServerChanged()
    {
        throw new NotImplementedException();
    }

    private void OnClientChanged()
    {
        
    }
}